diff --git a/pixman/pixman-inlines.h b/pixman/pixman-inlines.h
index f785910..e1a9099 100644
--- a/pixman/pixman-inlines.h
+++ b/pixman/pixman-inlines.h
@@ -88,6 +88,49 @@ pixman_fixed_to_bilinear_weight (pixman_fixed_t x)
 	   ((1 << BILINEAR_INTERPOLATION_BITS) - 1);
 }
 
+#if defined(_M_ARM) && !defined(PIXMAN_NO_NEON_INTRINSICS)
+/* ── NEON bilinear (MSVC ARM32 UWP — Revenant) ────────────────────────────────
+ * MSVC can't build pixman's GAS NEON asm, and this inline is the single choke
+ * point for ALL bilinear scaling (per-pixel affine fetcher + 4 scanline fast
+ * paths). Hand-written arm_neon.h intrinsics, verified to emit real NEON
+ * (vld1/vmull/vshr) under cl 19.29 for ARM. Pixel-EXACT match of the 32-bit
+ * BITS<=8 scalar path below: per channel  c = (tl*w00 + tr*w10 + bl*w01 +
+ * br*w11) >> 16, truncated, weights summing to exactly 65536. Done in u32 lanes
+ * because a weight reaches 65536 (distx==disty==0) and overflows u16.
+ */
+#include <arm_neon.h>
+static force_inline uint32_t
+bilinear_interpolation (uint32_t tl, uint32_t tr,
+			uint32_t bl, uint32_t br,
+			int distx, int disty)
+{
+    distx <<= (8 - BILINEAR_INTERPOLATION_BITS);
+    disty <<= (8 - BILINEAR_INTERPOLATION_BITS);
+
+    /* area weights, same naming as the scalar path (distixiy..distxy) */
+    uint32_t w00 = (uint32_t)((256 - distx) * (256 - disty)); /* tl */
+    uint32_t w10 = (uint32_t)(distx * (256 - disty));	     /* tr */
+    uint32_t w01 = (uint32_t)((256 - distx) * disty);	     /* bl */
+    uint32_t w11 = (uint32_t)(distx * disty);		     /* br */
+
+    /* each pixel: 4 bytes B,G,R,A -> u32x4 lane per channel */
+    uint32x4_t c_tl = vmovl_u16 (vget_low_u16 (vmovl_u8 (vreinterpret_u8_u32 (vdup_n_u32 (tl)))));
+    uint32x4_t c_tr = vmovl_u16 (vget_low_u16 (vmovl_u8 (vreinterpret_u8_u32 (vdup_n_u32 (tr)))));
+    uint32x4_t c_bl = vmovl_u16 (vget_low_u16 (vmovl_u8 (vreinterpret_u8_u32 (vdup_n_u32 (bl)))));
+    uint32x4_t c_br = vmovl_u16 (vget_low_u16 (vmovl_u8 (vreinterpret_u8_u32 (vdup_n_u32 (br)))));
+
+    uint32x4_t acc = vmulq_u32 (c_tl, vdupq_n_u32 (w00));
+    acc = vmlaq_u32 (acc, c_tr, vdupq_n_u32 (w10));
+    acc = vmlaq_u32 (acc, c_bl, vdupq_n_u32 (w01));
+    acc = vmlaq_u32 (acc, c_br, vdupq_n_u32 (w11));
+    acc = vshrq_n_u32 (acc, 16);			     /* truncate, matches scalar */
+
+    /* narrow u32x4 -> u16x4 -> u8x8, repack the 4 bytes into one uint32 */
+    uint16x4_t n16 = vmovn_u32 (acc);
+    uint8x8_t  n8  = vmovn_u16 (vcombine_u16 (n16, n16));
+    return vget_lane_u32 (vreinterpret_u32_u8 (n8), 0);
+}
+#else /* scalar reference paths */
 #if BILINEAR_INTERPOLATION_BITS <= 4
 /* Inspired by Filter_32_opaque from Skia */
 static force_inline uint32_t
@@ -221,6 +264,7 @@ bilinear_interpolation (uint32_t tl, uint32_t tr,
 
 #endif
 #endif // BILINEAR_INTERPOLATION_BITS <= 4
+#endif // _M_ARM NEON intrinsics vs scalar
 
