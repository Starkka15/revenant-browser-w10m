diff --git a/core/shared/platform/windows/win_thread.c b/core/shared/platform/windows/win_thread.c
index 1f6a57e..28e61b0 100644
--- a/core/shared/platform/windows/win_thread.c
+++ b/core/shared/platform/windows/win_thread.c
@@ -159,7 +159,12 @@ os_thread_sys_init()
     if (os_mutex_init(&thread_data_list_lock) != BHT_OK)
         goto fail5;
 
-    if ((module = GetModuleHandle((LPCTSTR) "kernel32"))) {
+    /* GetModuleHandle() is a desktop-only Win32 API; it is not available to UWP/WindowsStore
+       apps (unresolved __imp_GetModuleHandle at link). GetModuleHandleExW is the app-partition
+       equivalent. GetCurrentThreadStackLimits itself is UWP-allowed, so the GetProcAddress lookup
+       still succeeds; if the module can't be resolved the pointer stays NULL and WAMR falls back. */
+    module = NULL;
+    if (GetModuleHandleExW(0, L"kernel32", &module) && module) {
         *(void **)&GetCurrentThreadStackLimits_Kernel32 =
             GetProcAddress(module, "GetCurrentThreadStackLimits");
     }
